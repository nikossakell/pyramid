# Copy to .env and fill in. Never commit .env.

# --- Database ---
POSTGRES_USER=pyramid
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pyramid
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://pyramid:change-me@postgres:5432/pyramid

# --- Security ---
# Σε ENVIRONMENT=production η εφαρμογή ΔΕΝ ξεκινά αν κάποιο από τα τρία μυστικά έχει < 32 χαρακτήρες.
# Νέα τιμή: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-32-bytes-minimum
JWT_ALGORITHM=HS256
# ΠΡΟΣΧΕΔΙΟ: διάρκεια token (ΑΝΟΙΧΤΗ ΑΠΟΦΑΣΗ: TTL token)
ACCESS_TOKEN_TTL_MINUTES=720
ACCESS_KEY_PEPPER=change-me
# Header X-Admin-Token για /api/v1/admin (ο Nginx επιτρέπει τα admin endpoints μόνο από το VPN του ΑΠΘ)
ADMIN_TOKEN=change-me
# ΠΡΟΣΧΕΔΙΟ: όριο αποτυχιών login ανά IP (in-memory: απαιτεί έναν worker). Χαλαρό σκόπιμα: πολλά παιδιά
# μπορεί να μοιράζονται IP (ακαδημίες, σχολεία)· τα κλειδιά των 60 bit κάνουν τις δοκιμές μη ρεαλιστικές.
LOGIN_MAX_FAILURES=30
LOGIN_WINDOW_MINUTES=15
# Από ποιες διευθύνσεις το backend εμπιστεύεται X-Forwarded-For: ο Nginx. Προεπιλογή: το subnet του δικτύου
# στο docker-compose.prod.yml. ΠΟΤΕ "*".
FORWARDED_ALLOW_IPS=172.28.0.0/24

# --- API ---
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Λίστα χωρισμένη με κόμμα· ποτέ "*" (η εφαρμογή δεν ξεκινά σε production)
CORS_ORIGINS=http://localhost:5173
ADMIN_ALLOWED_CIDRS=10.0.0.0/8
# ΜΟΝΟ για ανάπτυξη/επίδειξη: demo φίλτρα φωτογραφίας και αναγνώριση. Σε production πρέπει να είναι false.
DEMO_MODE=false
# Swagger UI (/docs) και /openapi.json. Κενό = ανοιχτά εκτός production· σε production ΔΕΝ επιτρέπονται.
API_DOCS=
# ΠΡΟΣΧΕΔΙΟ: ζώνη ώρας για το «σήμερα» του παιδιού, τις ημέρες και τη νυχτερινή εργασία
APP_TIMEZONE=Europe/Athens
# ΠΡΟΣΧΕΔΙΟ: η ομάδα ελέγχου μπαίνει στην εφαρμογή από αυτή την ημέρα (YYYY-MM-DD). Κενό = όχι κατά τη μελέτη.
CONTROL_ACCESS_FROM=

# --- Τρόφιμα και γεύματα ---
# Φάκελος των CSV. Προεπιλογή: <repo>/data τοπικά, /data στο container (βλ. docker-compose). Σχετικά paths
# παρακάτω λύνονται ως προς αυτόν. Συνήθως δεν χρειάζεται να οριστεί.
# DATA_DIR=/data
# ΜΟΝΟ demo τιμές μέχρι να υπάρξει πραγματικός πίνακας σύνθεσης· σε production η εφαρμογή δεν ξεκινά με demo γραμμές.
FOODS_CSV=demo_foods.csv
FOOD_ALIASES_CSV=demo_food_aliases.csv
# ΠΡΟΣΧΕΔΙΟ: γεύμα / «πλήρης ημέρα» από σήμερα έως τόσες ημέρες πριν
MEAL_BACKDATE_DAYS=1
# ΑΝΟΙΧΤΗ ΑΠΟΦΑΣΗ M07: αν το παιδί μπορεί να διαγράψει γεύμα (soft delete)
ALLOW_MEAL_DELETE=false
# ΠΡΟΣΧΕΔΙΟ: συνήθης πρόσληψη στις τελευταίες τόσες ημέρες (ο engine θέλει ≥ 3 πλήρεις)
EVALUATION_WINDOW_DAYS=7

# --- Photo handling (Rule 7: nothing touches disk) ---
MAX_PHOTO_BYTES=1048576
# Αυστηρό όριο στον server: εικόνα με μεγαλύτερη πλευρά > 448 px απορρίπτεται (ίδιο με τον browser, DPIA)
PHOTO_MAX_EDGE_PX=448
# ΠΡΟΣΧΕΔΙΟ: μετά από τόσες απορρίψεις σε τόσες ώρες, αναστολή φωτογραφίας για τόσες ώρες (κείμενο/αναζήτηση μένουν)
PHOTO_REJECT_LIMIT=5
PHOTO_REJECT_WINDOW_HOURS=24
PHOTO_SUSPENSION_HOURS=24
# ΠΡΟΣΧΕΔΙΟ: πρόταση αναγνώρισης με βεβαιότητα από εδώ και πάνω = «σίγουρο», αλλιώς «ίσως» (ποτέ αριθμός στο παιδί)
PHOTO_CONFIDENT_MIN=0.80

# --- Content safety (Rule 8) ---
NSFW_THRESHOLD=0.70
FOOD_GATE_THRESHOLD=0.60
SERVER_FOOD_RECHECK_THRESHOLD=0.50

# --- Local models (see make models) ---
MODELS_DIR=/app/models
OLIVEGEMMA_PATH=/app/models/olivegemma-3b
KRIKRI_MODEL_PATH=/app/models/krikri-8b-instruct-q4_k_m.gguf
EMBEDDING_MODEL_PATH=/app/models/multilingual-e5-large
NSFW_MODEL_PATH=/app/models/nsfw_image_detection
FOOD_GATE_MODEL_PATH=/app/models/food_gate.h5

# --- Krikri inference server (llama.cpp) ---
# Ο presenter (4.1) χρησιμοποιεί το Krikri ΜΟΝΟ αν οριστούν και το LLM_BASE_URL και το LLM_MODEL· αλλιώς μόνο
# τα σταθερά κείμενα (η εφαρμογή λειτουργεί πλήρως και χωρίς LLM).
LLM_BASE_URL=http://llm:8080
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
# ΠΡΟΣΧΕΔΙΟ: αναμονή ανά μήνυμα ανατροφοδότησης· μετά, σταθερό κείμενο
PRESENTER_TIMEOUT_SECONDS=20

# --- RAG ---
RAG_DB_PATH=/app/rag_db
RAG_COLLECTION=efsa_opinions
RAG_TOP_K=4

# --- Jobs ---
CARD_DROP_CRON_HOUR=3
SAFETY_MONITORING_CRON_MINUTE=*/30

# --- Researcher alerts ---
ALERT_EMAIL_FROM=pyramid@uom.gr
ALERT_EMAIL_TO=researcher@uom.gr
SMTP_HOST=smtp.uom.gr
SMTP_PORT=587
